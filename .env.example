# AERO 34 Environment Configuration
PORT=3001
NODE_ENV=production
DATABASE_PATH=./data/aero34.db

# Transactional Email Dispatch (Resend or Postmark)
RESEND_API_KEY=
EMAIL_FROM=dispatch@aero34.com

# Admin initial seed credentials (set once during initial migration)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=aero34admin

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://aero34.com
